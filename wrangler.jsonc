{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "examaware-docs",
  "compatibility_date": "2025-11-18",
  "build": {
    "command": "pnpm run docs:build"
  },
  "assets": {
    "directory": "./src/.vuepress/dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}